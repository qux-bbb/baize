# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go
*.test
*.out
cmd/                     # go build 二进制输出

# Rust
agent/target/
**/*.rs.bk

# WiX 构建产物（agent/wix/ 源码需提交，产物可重建）
agent/wix/*.msi
agent/wix/*.wixobj
agent/wix/*.wixpdb
# TLS CA 证书（Server 生成后拷贝进来，构建输入不提交）
agent/wix/ca.crt
# agent.conf 由 build_msi.bat 生成（检测 ca.crt 决定 ca 字段）
agent/wix/agent.conf

# IDE
.vscode/
.idea/
*.swp
*.swo

# Proto generated (依赖 protoc，不提交)
# proto/gen/  ← 如果你想提交生成的代码就注释掉这行

# 安装包 / 临时文件
*.zip
*-init.exe
*.log
/temp/
*.pdb
node_modules
server/web/node_modules
server/web/dist
server/cmd/web
# Server 构建产物（release 包/二进制，可重建）
server/release/
server/baize-server*

tmp.txt
data/
